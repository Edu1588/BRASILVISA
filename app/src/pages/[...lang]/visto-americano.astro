---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceAside from '../../components/ServiceAside.astro';
import CtaBand from '../../components/CtaBand.astro';
import ServiceSchema from '../../components/ServiceSchema.astro';
import { DICTS, langPaths, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = DICTS[lang];
const v = t.vistoAmericano;
---

<Base lang={lang} page="vistoAmericano" title={v.meta.title} description={v.meta.description}>
  <ServiceSchema slot="head" lang={lang} page="vistoAmericano" name={t.nav.vistoAmericano} description={t.vistoAmericano.meta.description} />
  <PageHero lang={lang} page="vistoAmericano" label={t.nav.vistoAmericano} title={v.hero.title} subtitle={v.hero.subtitle} wa="vistoEua" foto="vistoAmericano" />

  <div class="wrap section grid gap-14 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="space-y-16">
      <section class="grid gap-12 md:grid-cols-2">
        <div>
          <h2 class="text-2xl">{v.included.title}</h2>
          <ul class="check-list mt-4">{v.included.items.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div>
          <h2 class="text-2xl">{v.avoid.title}</h2>
          <ul class="x-list mt-4 text-grafite-suave">{v.avoid.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      </section>

      <section class="guilloche rounded-2xl border border-guilloche p-7 md:p-9">
        <h2 class="text-2xl">{v.fee.title}</h2>
        <p class="measure mt-4">{v.fee.text}</p>
        <a href={v.fee.src} target="_blank" rel="noopener" class="text-link mt-4 inline-block">{v.fee.link}</a>
      </section>

      <section>
        <h2 class="text-2xl">{v.denied.title}</h2>
        <p class="measure mt-4">{v.denied.text}</p>
      </section>
    </div>

    <ServiceAside lang={lang} wa="vistoEua" disclaimer={v.disclaimer} />
  </div>

  <CtaBand lang={lang} title={t.home.final.title} text={t.home.final.text} wa="vistoEua" />
</Base>
