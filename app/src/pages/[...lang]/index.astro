---
import Base from '../../layouts/Base.astro';
import HeroDoc from '../../components/HeroDoc.astro';
import CtaBand from '../../components/CtaBand.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import WaIcon from '../../components/WaIcon.astro';
import ContactForm from '../../components/ContactForm.tsx';
import { DICTS, SERVICES, WHATSAPP, href, langPaths, waLink, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = DICTS[lang];
const h = t.home;
const langIndex = { pt: 0, en: 1, zh: 2 }[lang];
const [main, ...rest] = SERVICES;
---

<Base lang={lang} page="home" title={h.meta.title} description={h.meta.description}>
  <!-- Herói -->
  <section class="guilloche-noite overflow-hidden">
    <div class="wrap grid items-center gap-10 py-12 lg:min-h-[min(calc(100svh-4.5rem),880px)] lg:grid-cols-[1.05fr_1fr] lg:py-8">
      <div>
        <p class="font-medium text-branco/70">{h.hero.kicker}</p>
        <h1 class="hero-title mt-4 max-w-[17ch] text-[clamp(2.3rem,4.8vw,3.9rem)] leading-[1.06]">{h.hero.title}</h1>
        <p class="measure mt-6 text-lg text-branco/80">{h.hero.subtitle}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={waLink(lang, 'geral')} target="_blank" rel="noopener" class="btn btn-wa"><WaIcon />{h.hero.cta}</a>
          <a href="#servicos" class="btn btn-ghost-light">{h.hero.secondary}</a>
        </div>
        <p class="mt-4 text-sm text-branco/70">{h.hero.note}</p>
      </div>
      <div class="flex justify-center lg:justify-end">
        <HeroDoc />
      </div>
    </div>
  </section>

  <!-- Serviços: o principal em destaque, os demais em grade -->
  <section id="servicos" class="section scroll-mt-20">
    <div class="wrap">
      <h2 class="text-[clamp(1.9rem,3.4vw,2.7rem)]">{h.servicesTitle}</h2>
      <a href={href(lang, main)} class="group mt-10 grid gap-4 rounded-3xl bg-tinta p-8 text-branco md:grid-cols-[1fr_auto] md:items-center md:p-12" data-reveal>
        <div>
          <span class="font-display text-2xl font-bold !text-branco md:text-3xl">{t.services[main].label}</span>
          <p class="mt-3 max-w-[52ch] text-branco/80">{t.services[main].card}</p>
        </div>
        <span class="btn btn-light shrink-0">{t.common.seeMore}</span>
      </a>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          rest.map((k) => (
            <li>
              <a href={href(lang, k)} class="group flex h-full flex-col rounded-2xl border border-guilloche bg-branco p-6 hover:border-carmim-vivo">
                <span class="font-display text-lg font-semibold text-tinta group-hover:text-carmim-vivo">{t.services[k].label}</span>
                <span class="mt-2 text-grafite-suave">{t.services[k].card}</span>
                <span class="mt-auto pt-4 text-sm font-semibold text-tinta underline underline-offset-4">{t.common.seeMore}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Formulário -->
  <section class="section guilloche !pt-[clamp(56px,7vw,96px)]">
    <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.4fr]">
      <div>
        <h2 class="text-[clamp(1.7rem,3vw,2.4rem)]">{h.formTitle}</h2>
        <p class="mt-4 text-grafite-suave">{h.formText}</p>
        <a href={href(lang, 'quemSomos')} class="text-link mt-6 inline-block">{t.nav.quemSomos}</a>
      </div>
      <div class="rounded-3xl border border-guilloche bg-branco p-6 md:p-10">
        <ContactForm
          client:visible
          labels={t.contato.form}
          privacyHref={href(lang, 'privacidade')}
          thanksHref={href(lang, 'obrigado')}
          whatsapp={WHATSAPP}
          defaultLanguage={langIndex}
        />
      </div>
    </div>
  </section>

  <CtaBand lang={lang} title={t.services.investidor.cta.title} text={t.services.investidor.cta.text} wa="investidor" />
  <div class="pt-[clamp(72px,10vw,136px)]"><MapEmbed lang={lang} /></div>
</Base>
