---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { DICTS, langPaths, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = DICTS[lang];
const s = t.sobre;
---

<Base lang={lang} page="sobre" title={s.meta.title} description={s.meta.description}>
  <PageHero lang={lang} page="sobre" label={t.nav.sobre} title={s.title} subtitle={s.text} trust={false} />

  <section class="section">
    <dl class="wrap grid gap-10 md:grid-cols-2">
      <div class="border-t-2 border-tinta pt-5">
        <dt class="text-lg font-bold text-tinta">{s.mission.label}</dt>
        <dd class="mt-2 text-grafite-suave">{s.mission.text}</dd>
      </div>
      <div class="border-t-2 border-tinta pt-5">
        <dt class="text-lg font-bold text-tinta">{s.values.label}</dt>
        <dd class="mt-2 text-grafite-suave">{s.values.text}</dd>
      </div>
    </dl>
  </section>

  <section class="section guilloche !pt-[clamp(56px,7vw,96px)]">
    <div class="wrap">
      <h2 class="text-[clamp(1.9rem,3.4vw,2.7rem)]">{s.teamTitle}</h2>
      <ul class="mt-10 grid gap-10">
        {
          s.team.map((m) => (
            <li class="grid gap-8 md:grid-cols-[280px_1fr] md:items-start">
              {m.photo ? (
                <img src={m.photo} alt={m.name} width="280" height="340" loading="lazy" class="aspect-[14/17] w-full rounded-2xl object-cover" />
              ) : (
                <div class="grid aspect-[14/17] w-full place-items-center rounded-2xl border border-dashed border-guilloche bg-papel p-6 text-center text-sm text-grafite-suave">
                  {s.photoPending}
                </div>
              )}
              <div>
                <h3 class="text-2xl">{m.name}</h3>
                <p class="mt-1 font-semibold text-carmim">{m.role}</p>
                {m.bio && <p class="measure mt-4">{m.bio}</p>}
                <h4 class="mt-8 font-bold text-tinta">{s.certsTitle}</h4>
                <ul class="check-list mt-2 text-grafite-suave">{s.certs.map((c) => <li>{c}</li>)}</ul>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand lang={lang} title={t.home.final.title} text={t.home.final.text} />
</Base>
