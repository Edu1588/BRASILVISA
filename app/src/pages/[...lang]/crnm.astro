---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceAside from '../../components/ServiceAside.astro';
import SourceStamp from '../../components/SourceStamp.astro';
import CtaBand from '../../components/CtaBand.astro';
import ServiceSchema from '../../components/ServiceSchema.astro';
import { DICTS, langPaths, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = DICTS[lang];
const c = t.crnm;
---

<Base lang={lang} page="crnm" title={c.meta.title} description={c.meta.description}>
  <ServiceSchema slot="head" lang={lang} page="crnm" name={t.nav.crnm} description={t.crnm.meta.description} />
  <PageHero lang={lang} page="crnm" label={t.nav.crnm} title={c.hero.title} subtitle={c.hero.subtitle} wa="crnm" foto="crnm" />

  <div class="wrap section grid gap-14 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="space-y-16">
      <section>
        <h2 class="text-2xl">{c.what.title}</h2>
        <p class="measure mt-4">{c.what.text}</p>
        <SourceStamp lang={lang} href={c.what.src} label={c.what.srcLabel} dated={false} />
      </section>

      <section>
        <h2 class="text-2xl">{c.who.title}</h2>
        <ul class="check-list measure mt-4">{c.who.items.map((i) => <li>{i}</li>)}</ul>
      </section>

      <section>
        <h2 class="text-2xl">{c.deadlines.title}</h2>
        <dl class="mt-6 divide-y divide-guilloche rounded-2xl border border-guilloche bg-branco">
          {
            c.deadlines.items.map((d) => (
              <div class="grid gap-1 px-6 py-5 sm:grid-cols-[14rem_1fr] sm:gap-6">
                <dt class="font-semibold text-tinta">{d.label}</dt>
                <dd>
                  {d.value}
                  <span class="source-stamp mt-1 block">
                    <a href={d.src} target="_blank" rel="noopener">{d.srcLabel}</a>
                  </span>
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section>
        <h2 class="text-2xl">{c.fees.title}</h2>
        <div class="guilloche mt-6 overflow-hidden rounded-2xl border border-guilloche">
          <table class="w-full text-left">
            <thead class="bg-tinta text-branco">
              <tr>{c.fees.head.map((h) => <th scope="col" class="px-6 py-3 font-semibold">{h}</th>)}</tr>
            </thead>
            <tbody class="divide-y divide-guilloche">
              {
                c.fees.rows.map(([k, v]) => (
                  <tr>
                    <th scope="row" class="px-6 py-4 font-normal">{k}</th>
                    <td class="px-6 py-4 font-bold whitespace-nowrap text-tinta">{v}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="measure mt-4 text-grafite-suave">{c.fees.note}</p>
        <SourceStamp lang={lang} href={c.fees.src} label={c.fees.srcLabel} />
      </section>

      <section class="grid gap-12 md:grid-cols-2">
        <div>
          <h2 class="text-2xl">{c.do.title}</h2>
          <ul class="check-list mt-4">{c.do.items.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div>
          <h2 class="text-2xl">{c.avoid.title}</h2>
          <ul class="x-list mt-4 text-grafite-suave">{c.avoid.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      </section>
    </div>

    <ServiceAside lang={lang} wa="crnm" disclaimer={c.disclaimer} />
  </div>

  <CtaBand lang={lang} title={c.cta.title} text={c.cta.text} wa="crnm" />
</Base>
