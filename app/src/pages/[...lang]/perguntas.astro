---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.tsx';
import { DICTS, langPaths, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = DICTS[lang];
const p = t.perguntas;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: t.lang,
  mainEntity: p.items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---

<Base lang={lang} page="perguntas" title={p.meta.title} description={p.meta.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <PageHero lang={lang} page="perguntas" label={t.nav.perguntas} title={p.title} trust={false} />
  <section class="section">
    <div class="wrap max-w-4xl">
      <Faq client:load items={p.items} sourceLabel={t.source} headingLevel={2} />
    </div>
  </section>
  <CtaBand lang={lang} title={t.home.final.title} text={t.home.final.text} />
</Base>
