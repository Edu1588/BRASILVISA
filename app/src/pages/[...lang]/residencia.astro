---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceAside from '../../components/ServiceAside.astro';
import CtaBand from '../../components/CtaBand.astro';
import { DICTS, langPaths, waLink, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = DICTS[lang];
const r = t.residencia;
---

<Base lang={lang} page="residencia" title={r.meta.title} description={r.meta.description}>
  <PageHero lang={lang} page="residencia" label={t.nav.residencia} title={r.hero.title} subtitle={r.hero.subtitle} wa="residencia" />

  <div class="wrap section grid gap-14 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="space-y-16">
      <section>
        <h2 class="text-2xl">{r.fronts.title}</h2>
        <dl class="mt-6 divide-y divide-guilloche rounded-2xl border border-guilloche bg-branco">
          {
            r.fronts.items.map((f) => (
              <div class="grid gap-1 px-6 py-5 sm:grid-cols-[12rem_1fr] sm:gap-6">
                <dt class="font-semibold text-tinta">{f.title}</dt>
                <dd>{f.text}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section>
        <h2 class="text-2xl">{r.how.title}</h2>
        <ol class="measure mt-6 space-y-4">
          {
            r.how.items.map((i, idx) => (
              <li class="flex gap-4">
                <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-tinta text-sm font-bold text-branco">{idx + 1}</span>
                <span class="pt-0.5">{i}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="rounded-2xl bg-tinta p-8 text-branco md:p-10">
        <h2 class="text-2xl !text-branco">{r.company.title}</h2>
        <p class="measure mt-3 text-branco/80">{r.company.text}</p>
        <a href={waLink(lang, 'empresa')} target="_blank" rel="noopener" class="btn btn-light mt-6">{t.common.talk}</a>
      </section>
    </div>

    <ServiceAside lang={lang} wa="residencia" disclaimer={r.disclaimer} />
  </div>

  <CtaBand lang={lang} title={r.cta.title} text={r.cta.text} wa="residencia" />
</Base>
