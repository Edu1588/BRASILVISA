---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceAside from '../../components/ServiceAside.astro';
import SourceStamp from '../../components/SourceStamp.astro';
import CtaBand from '../../components/CtaBand.astro';
import { DICTS, langPaths, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = DICTS[lang];
const n = t.naturalizacao;
---

<Base lang={lang} page="naturalizacao" title={n.meta.title} description={n.meta.description}>
  <PageHero lang={lang} page="naturalizacao" label={t.nav.naturalizacao} title={n.hero.title} subtitle={n.hero.subtitle} wa="naturalizacao" />

  <div class="wrap section grid gap-14 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="space-y-16">
      <section>
        <h2 class="text-2xl">{n.types.title}</h2>
        <dl class="mt-6 divide-y divide-guilloche rounded-2xl border border-guilloche bg-branco">
          {
            n.types.items.map((m) => (
              <div class="grid gap-1 px-6 py-5 sm:grid-cols-[14rem_1fr] sm:gap-6">
                <dt class="font-semibold text-tinta">{m.title}</dt>
                <dd>{m.text}</dd>
              </div>
            ))
          }
        </dl>
        <SourceStamp lang={lang} href={n.types.src} label={n.types.srcLabel} dated={false} />
      </section>

      <section class="guilloche rounded-2xl border border-guilloche p-7 md:p-9">
        <h2 class="text-2xl">{n.official.title}</h2>
        <p class="measure mt-4">{n.official.text}</p>
        <SourceStamp lang={lang} href={n.official.src} label={n.official.srcLabel} />
      </section>

      <section>
        <h2 class="text-2xl">{n.how.title}</h2>
        <ol class="measure mt-6 space-y-4">
          {
            n.how.items.map((i, idx) => (
              <li class="flex gap-4">
                <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-tinta text-sm font-bold text-branco">{idx + 1}</span>
                <span class="pt-0.5">{i}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section>
        <h2 class="text-2xl">{n.avoid.title}</h2>
        <ul class="x-list measure mt-4 text-grafite-suave">{n.avoid.items.map((i) => <li>{i}</li>)}</ul>
      </section>
    </div>

    <ServiceAside lang={lang} wa="naturalizacao" disclaimer={n.disclaimer} />
  </div>

  <CtaBand lang={lang} title={n.cta.title} text={n.cta.text} wa="naturalizacao" />
</Base>
