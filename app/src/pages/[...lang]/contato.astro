---
import WaIcon from '../../components/WaIcon.astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import ContactForm from '../../components/ContactForm.tsx';
import { DICTS, WHATSAPP, langPaths, href, waLink, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = DICTS[lang];
const c = t.contato;
const langIndex = { pt: 0, en: 1, zh: 2 }[lang];
---

<Base lang={lang} page="contato" title={c.meta.title} description={c.meta.description}>
  <PageHero lang={lang} page="contato" label={t.nav.contato} title={c.title} subtitle={c.text} trust={false} />

  <section class="section">
    <div class="wrap grid gap-14 lg:grid-cols-[minmax(0,1fr)_340px]">
      <div class="rounded-3xl border border-guilloche bg-branco p-6 md:p-10">
        <ContactForm
          client:visible
          labels={c.form}
          privacyHref={href(lang, 'privacidade')}
          thanksHref={href(lang, 'obrigado')}
          whatsapp={WHATSAPP}
          defaultLanguage={langIndex}
        />
      </div>
      <aside class="lg:pt-4">
        <a href={waLink(lang, 'geral')} target="_blank" rel="noopener" class="btn btn-wa w-full"><WaIcon />{c.waButton}</a>
        <p class="mt-3 text-sm text-grafite-suave">{t.common.reply24}</p>
      </aside>
    </div>
  </section>

  <MapEmbed lang={lang} />
</Base>
