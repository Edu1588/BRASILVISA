---
// Aviso de cookies (LGPD). Aceitar e Recusar têm o mesmo peso visual; a lógica fica em scripts/consent.ts.
import { DICTS, href, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = DICTS[lang].cookies;
---

<div
  id="cookie-banner"
  hidden
  role="dialog"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-text"
  class="fixed inset-x-0 bottom-0 z-50 border-t border-guilloche bg-white p-4 shadow-[0_-8px_30px_rgb(0_0_0/0.12)] lg:inset-x-auto lg:bottom-6 lg:left-6 lg:max-w-md lg:rounded-2xl lg:border"
>
  <p id="cookie-title" class="font-semibold text-tinta">{c.title}</p>
  <p id="cookie-text" class="mt-1 text-sm text-grafite-suave">
    {c.text}{' '}
    <a href={href(lang, 'privacidade')} class="text-link">{c.policy}</a>
  </p>
  <div class="mt-4 grid grid-cols-2 gap-3">
    <button type="button" data-cookie-decline class="btn btn-ghost !min-h-11 !py-2">{c.decline}</button>
    <button type="button" data-cookie-accept class="btn btn-ghost !min-h-11 !py-2">{c.accept}</button>
  </div>
</div>
