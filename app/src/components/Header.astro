---
// Cabeçalho enxuto de landing page: logo, idiomas e WhatsApp. Os serviços ficam no rodapé e na página inicial.
import WaIcon from './WaIcon.astro';
import { DICTS, LANGS, href, waLink, type Lang, type PageKey } from '../i18n';
import type { Dict } from '../i18n/pt';

interface Props { lang: Lang; page: PageKey | '404'; wa?: keyof Dict['wa'] }
const { lang, page, wa = 'geral' } = Astro.props;
const t = DICTS[lang];
const langShort: Record<Lang, string> = { pt: 'PT', en: 'EN', zh: '中文' };
const target = page === '404' ? 'home' : page;
---

<header class="sticky top-0 z-40 border-b border-guilloche/70 bg-papel/92 backdrop-blur">
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-4">
    <a href={href(lang, 'home')} class="shrink-0" aria-label="BrasilVisa">
      <img src="/logo-cor.webp" alt="BrasilVisa" width="170" height="36" class="h-8 w-auto sm:h-9" />
    </a>

    <div class="flex items-center gap-3 sm:gap-4">
      <ul class="flex items-center gap-1 whitespace-nowrap text-sm" aria-label={t.nav.languages}>
        {
          LANGS.map((l) => (
            <li>
              <a
                href={href(l, target)}
                lang={DICTS[l].lang}
                hreflang={DICTS[l].lang}
                class:list={['inline-block rounded-full px-2.5 py-1.5', l === lang ? 'bg-tinta text-branco' : 'text-grafite-suave hover:text-tinta']}
                aria-current={l === lang ? 'true' : undefined}
                data-astro-reload
              >
                {langShort[l]}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={waLink(lang, wa)} target="_blank" rel="noopener" class="btn btn-wa hidden !min-h-11 !py-2 whitespace-nowrap text-[0.95rem] md:inline-flex">
        <WaIcon />
        {t.nav.cta}
      </a>
    </div>
  </div>
</header>
