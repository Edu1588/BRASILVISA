---
// Bandeiras do seletor de idioma em SVG (emoji de bandeira não aparece no Windows, que mostra só as letras).
import type { Lang } from '../i18n';
interface Props { lang: Lang; class?: string }
const { lang, class: cls = 'h-3.5 w-5' } = Astro.props;
---

{
  lang === 'pt' && (
    <svg viewBox="0 0 20 14" class={cls} aria-hidden="true">
      <rect width="20" height="14" rx="2" fill="#009C3B" />
      <path d="M10 1.6 18.2 7 10 12.4 1.8 7Z" fill="#FFDF00" />
      <circle cx="10" cy="7" r="3.2" fill="#002776" />
      <path d="M6.9 6.4c2.1-.5 4.3-.2 6.2.9" stroke="#fff" stroke-width=".55" fill="none" />
    </svg>
  )
}
{
  lang === 'en' && (
    <svg viewBox="0 0 20 14" class={cls} aria-hidden="true">
      <clipPath id="flag-us-clip"><rect width="20" height="14" rx="2" /></clipPath>
      <g clip-path="url(#flag-us-clip)">
        <rect width="20" height="14" fill="#fff" />
        <path d="M0 0h20v1.08H0zm0 2.15h20v1.08H0zm0 2.16h20v1.07H0zm0 2.15h20v1.08H0zm0 2.15h20v1.08H0zm0 2.16h20v1.07H0zm0 2.15h20V14H0z" fill="#B22234" />
        <rect width="8.6" height="7.54" fill="#3C3B6E" />
        <g fill="#fff">
          <circle cx="1.4" cy="1.3" r=".45" /><circle cx="3.6" cy="1.3" r=".45" /><circle cx="5.8" cy="1.3" r=".45" /><circle cx="8" cy="1.3" r=".45" />
          <circle cx="2.5" cy="3.1" r=".45" /><circle cx="4.7" cy="3.1" r=".45" /><circle cx="6.9" cy="3.1" r=".45" />
          <circle cx="1.4" cy="4.9" r=".45" /><circle cx="3.6" cy="4.9" r=".45" /><circle cx="5.8" cy="4.9" r=".45" /><circle cx="8" cy="4.9" r=".45" />
          <circle cx="2.5" cy="6.6" r=".45" /><circle cx="4.7" cy="6.6" r=".45" /><circle cx="6.9" cy="6.6" r=".45" />
        </g>
      </g>
    </svg>
  )
}
{
  lang === 'zh' && (
    <svg viewBox="0 0 20 14" class={cls} aria-hidden="true">
      <rect width="20" height="14" rx="2" fill="#EE1C25" />
      <path d="m4 1.6.68 2.08h2.19L5.1 4.97l.67 2.08L4 5.77 2.23 7.05l.67-2.08L1.13 3.68h2.19Z" fill="#FFFF00" />
      <g fill="#FFFF00">
        <circle cx="7.6" cy="1.6" r=".55" /><circle cx="8.9" cy="3" r=".55" /><circle cx="8.9" cy="4.9" r=".55" /><circle cx="7.6" cy="6.2" r=".55" />
      </g>
    </svg>
  )
}
