---
import { DICTS, EMAIL, SOCIAL, WHATSAPP_DISPLAY, href, waLink, type Lang, type PageKey } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = DICTS[lang];
const services: PageKey[] = ['crnm', 'naturalizacao', 'residencia', 'vistoAmericano'];
const company: PageKey[] = ['sobre', 'cases', 'perguntas', 'contato'];
const year = new Date().getFullYear();
---

<footer class="bg-tinta-escura pb-28 text-branco/85 lg:pb-0">
  <div class="wrap grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-sm">
      <img src="/logo-escuro.webp" alt="Migrafácil" width="124" height="56" class="h-14 w-auto" loading="lazy" />
      <p class="mt-5">{t.footer.about}</p>
      <address class="mt-5 not-italic leading-relaxed">
        {t.footer.address}<br />
        <a href={waLink(lang, 'geral')} target="_blank" rel="noopener" class="inline-block py-1 underline underline-offset-4">WhatsApp {WHATSAPP_DISPLAY}</a><br />
        <a href={`mailto:${EMAIL}`} class="underline underline-offset-4">{EMAIL}</a>
      </address>
      {t.footer.hours && <p class="mt-3">{t.footer.hoursLabel}: {t.footer.hours}</p>}
    </div>
    <nav aria-label={t.home.services.title}>
      <h2 class="text-base font-semibold text-branco">{t.home.services.title}</h2>
      <ul class="mt-3 space-y-1">
        {services.map((p) => <li><a href={href(lang, p)} class="inline-block py-1 hover:text-branco hover:underline">{t.nav[p]}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Migrafácil">
      <h2 class="text-base font-semibold text-branco">Migrafácil</h2>
      <ul class="mt-3 space-y-1">
        {company.map((p) => <li><a href={href(lang, p)} class="inline-block py-1 hover:text-branco hover:underline">{t.nav[p]}</a></li>)}
        <li><a href={href(lang, 'privacidade')} class="inline-block py-1 hover:text-branco hover:underline">{t.footer.privacy}</a></li>
      </ul>
      <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-1 text-sm">
        <li><a href={SOCIAL.instagram} target="_blank" rel="noopener" class="inline-block py-1 underline underline-offset-4">Instagram</a></li>
        <li><a href={SOCIAL.facebook} target="_blank" rel="noopener" class="inline-block py-1 underline underline-offset-4">Facebook</a></li>
        <li><a href={SOCIAL.linkedin} target="_blank" rel="noopener" class="inline-block py-1 underline underline-offset-4">LinkedIn</a></li>
        <li><a href={SOCIAL.youtube} target="_blank" rel="noopener" class="inline-block py-1 underline underline-offset-4">YouTube</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-branco/15">
    <div class="wrap py-8 text-sm leading-relaxed text-branco/65">
      <p class="max-w-4xl">{t.footer.legal}</p>
      <p class="mt-4">© {year} Migrafácil e RNE Brasil. {t.footer.rights}</p>
    </div>
  </div>
</footer>
